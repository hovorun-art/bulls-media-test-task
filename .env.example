# Copy to .env (git-ignored). Every value has a default except the Gemini key.
#
# With Docker (docker compose up), compose.yaml sets HOST, PORT and DATABASE_PATH itself, so the
# values below for those are only for npm run dev. From this file Docker takes GOOGLE_API_KEY,
# GEMINI_MODEL and the limits; WEB_PORT (8080) and TRIAGE_PORT (3000) change the published ports.

# Gemini API key, required (free): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# HTTP server of apps/triage.
PORT=3000
HOST=127.0.0.1
# SQLite file with the runs and their traces (relative to apps/triage).
DATABASE_PATH=data/runs.sqlite
LOG_LEVEL=info
