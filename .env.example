# Copy to .env (git-ignored). Every value has a default except the Anthropic key.
#
# With Docker (docker compose up), compose.yaml sets HOST, PORT, OLLAMA_BASE_URL and DATABASE_PATH
# itself, so the values below for those are only for npm run dev. From this file Docker takes
# OLLAMA_MODEL, LLM_PROVIDER, the ANTHROPIC_* values and the limits; WEB_PORT (8080) and
# TRIAGE_PORT (3000) change the published ports.

# Model provider: "ollama" (default, free, local) or "anthropic" (paid API key).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# HTTP server of apps/triage.
PORT=3000
HOST=127.0.0.1
# SQLite file with the runs and their traces (relative to apps/triage).
DATABASE_PATH=data/runs.sqlite
LOG_LEVEL=info
